BETTER_CONTENT_DB_PORT=5433
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/better_content
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/better_content_test
E2E_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/better_content_e2e_test

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

AVALAI_API_KEY=
AI_SAFETY_IDENTIFIER_SECRET=

# Local development must opt in explicitly. Production uses the s3 driver and all generic ASSET_S3_* values.
ASSET_STORAGE_DRIVER=filesystem
ASSET_STORAGE_ROOT=.data/asset-storage
ASSET_STORAGE_VERSIONING=disabled
ASSET_S3_ENDPOINT=
ASSET_S3_REGION=
ASSET_S3_BUCKET=
ASSET_S3_ACCESS_KEY_ID=
ASSET_S3_SECRET_ACCESS_KEY=
ASSET_S3_FORCE_PATH_STYLE=false

# Worker deployment gate. The executable must be supplied by the deployment image;
# it is never downloaded dynamically. The exact version must match the pinned build.
FFPROBE_PATH=
FFPROBE_EXPECTED_VERSION=

# Optional worker-local temp directory. The runner requires at least 1 GiB free
# space per heavy job before it starts.
ASSET_WORKER_TEMP_DIR=

# Never set this in ordinary CI. Setting it to 1 requires the explicit live
# S3-compatible contract environment below and runs against that private bucket.
ASSET_STORAGE_LIVE_CONTRACT=0
