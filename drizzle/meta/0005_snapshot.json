        },
        "ai_runs_provider_check": {
          "name": "ai_runs_provider_check",
          "value": "(\"ai_runs\".\"provider\" = 'avalai' AND \"ai_runs\".\"model\" = 'gpt-5.6-luna') OR (\"ai_runs\".\"provider\" = 'openai' AND \"ai_runs\".\"model\" = 'gpt-5.6-terra')"
        },
        "ai_runs_model_check": {
          "name": "ai_runs_model_check",
          "value": "(\"ai_runs\".\"provider\" = 'avalai' AND \"ai_runs\".\"model\" = 'gpt-5.6-luna') OR (\"ai_runs\".\"provider\" = 'openai' AND \"ai_runs\".\"model\" = 'gpt-5.6-terra')"
        },
        "ai_runs_prompt_version_check": {
          "name": "ai_runs_prompt_version_check",
          "value": "\"ai_runs\".\"prompt_version\" = 'idea-generation/v1'"
        },
        "ai_runs_status_check": {
          "name": "ai_runs_status_check",
          "value": "\"ai_runs\".\"status\" IN ('PENDING', 'RUNNING', 'COMPLETED', 'FAILED')"
        },
        "ai_runs_error_category_check": {
          "name": "ai_runs_error_category_check",
          "value": "\"ai_runs\".\"error_category\" IS NULL OR \"ai_runs\".\"error_category\" IN ('TIMEOUT', 'RATE_LIMITED', 'PROVIDER_UNAVAILABLE', 'INVALID_OUTPUT', 'INTERRUPTED', 'UNKNOWN')"
        },
        "ai_runs_output_snapshot_status_check": {
          "name": "ai_runs_output_snapshot_status_check",
          "value": "\"ai_runs\".\"status\" = 'COMPLETED' OR \"ai_runs\".\"output_snapshot\" IS NULL"
        },
        "ai_runs_error_category_status_check": {
          "name": "ai_runs_error_category_status_check",
          "value": "\"ai_runs\".\"status\" = 'FAILED' OR \"ai_runs\".\"error_category\" IS NULL"
        },
        "ai_runs_lifecycle_timestamps_check": {
          "name": "ai_runs_lifecycle_timestamps_check",
          "value": "(\n        (\"ai_runs\".\"status\" = 'PENDING' AND \"ai_runs\".\"started_at\" IS NULL AND \"ai_runs\".\"completed_at\" IS NULL AND \"ai_runs\".\"failed_at\" IS NULL)\n        OR (\"ai_runs\".\"status\" = 'RUNNING' AND \"ai_runs\".\"started_at\" IS NOT NULL AND \"ai_runs\".\"completed_at\" IS NULL AND \"ai_runs\".\"failed_at\" IS NULL)\n        OR (\"ai_runs\".\"status\" = 'COMPLETED' AND \"ai_runs\".\"started_at\" IS NOT NULL AND \"ai_runs\".\"completed_at\" IS NOT NULL AND \"ai_runs\".\"failed_at\" IS NULL)\n        OR (\"ai_runs\".\"status\" = 'FAILED' AND \"ai_runs\".\"completed_at\" IS NULL AND \"ai_runs\".\"failed_at\" IS NOT NULL)\n      )"
        },
        "ai_runs_timestamp_order_check": {
          "name": "ai_runs_timestamp_order_check",
          "value": "(\n        \"ai_runs\".\"started_at\" IS NULL OR \"ai_runs\".\"started_at\" >= \"ai_runs\".\"created_at\"\n      ) AND (\n        \"ai_runs\".\"completed_at\" IS NULL OR \"ai_runs\".\"completed_at\" >= COALESCE(\"ai_runs\".\"started_at\", \"ai_runs\".\"created_at\")\n      ) AND (\n        \"ai_runs\".\"failed_at\" IS NULL OR \"ai_runs\".\"failed_at\" >= COALESCE(\"ai_runs\".\"started_at\", \"ai_runs\".\"created_at\")\n      )"
        }
      },
      "isRLSEnabled": false
    },
